// Cloudflare Workers config. Secrets are set with `npx wrangler secret put NAME`,
// never here: GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, SESSION_SECRET,
// ALLOWED_EMAILS, SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY, and OFFICE_ROLES if used.
{
  "name": "boromtech-finance",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    // Every request goes through the app, so signed-in-only files stay private.
    "run_worker_first": true
  },
  "vars": {
    "NODE_ENV": "production"
    // BASE_URL is a secret (`npx wrangler secret put BASE_URL`), so the account's
    // workers.dev address stays out of this public repo.
  },
  // Once a day, so the free Supabase project never sits idle for a week.
  "triggers": { "crons": ["0 3 * * *"] },
  "observability": { "enabled": true }
}
